#!/bin/bash -eu

. ./common.sh
common_init "$@"

pkgver=1.6.0
fetch_web "https://github.com/facebook/zstd/releases/download/v$pkgver/zstd-$pkgver.tar.gz" \
	2ba599ae2a257976278e7e71e998433a387bfd18aa7b78678229fd5d84f5e9b8
unpack_tar "zstd-$pkgver.tar.gz" --strip-components=1

cmake build/cmake "${CMAKE_FLAGS[@]}" \
	-DZSTD_LEGACY_SUPPORT=OFF
make

common_flat_tree
make DESTDIR=$INSTALL_DIR install
common_tidy

package $pkgver
